
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hexagon-style map of threatened-species observations across Australia.",
  "width": 400,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 340,
    "translate": [200, 200]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f4eb",
        "stroke": "#93aa98",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/threatened_species_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "latitude": "number",
            "longitude": "number",
            "occurrence_count": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.latitude) && isValid(datum.longitude) && isValid(datum.occurrence_count)"
        },
        {
          "calculate": "floor((datum.latitude + 45) / 1.3)",
          "as": "hex_row"
        },
        {
          "calculate": "floor((datum.longitude - 110 - (floor((datum.latitude + 45) / 1.3) % 2) * 0.75) / 1.5)",
          "as": "hex_col"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "occurrence_count",
              "as": "total_observations"
            }
          ],
          "groupby": [
            "hex_row",
            "hex_col"
          ]
        },
        {
          "calculate": "-45 + (datum.hex_row + 0.5) * 1.3",
          "as": "hex_latitude"
        },
        {
          "calculate": "110 + (datum.hex_col + 0.5) * 1.5 + (datum.hex_row % 2) * 0.75",
          "as": "hex_longitude"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "M0,-1 L0.866,-0.5 L0.866,0.5 L0,1 L-0.866,0.5 L-0.866,-0.5 Z",
        "filled": true,
        "size": 90,
        "opacity": 0.95,
        "stroke": "#ffffff",
        "strokeWidth": 0
      },
      "encoding": {
        "longitude": {
          "field": "hex_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "hex_latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "total_observations",
          "type": "quantitative",
          "title": "Threatened-species observations",
          "scale": {
            "type": "symlog",
            "range": [
              "#e6edcf",
              "#b8d28b",
              "#79a85b",
              "#3f794e",
              "#164c38"
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 210
          }
        },
        "tooltip": [
          {
            "field": "total_observations",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          },
          {
            "field": "hex_latitude",
            "type": "quantitative",
            "title": "Approximate latitude",
            "format": ".2f"
          },
          {
            "field": "hex_longitude",
            "type": "quantitative",
            "title": "Approximate longitude",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 11,
      "labelColor": "#315442",
      "titleColor": "#214b38"
    }
  }
}


